@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="content-card">
    <p class="section-kicker">A quiet moment</p>
    <h1>Something went wrong.</h1>
    <p>We could not complete that library desk task. Please try again or return to the overview.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return to overview</a>

    @if (Model.ShowRequestId)
    {
        <p class="mt-4 mb-0 text-muted"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
</div>

