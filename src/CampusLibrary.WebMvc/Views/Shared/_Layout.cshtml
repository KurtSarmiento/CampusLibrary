@functions {
    string IsActive(string controller, string action) =>
        (ViewContext.RouteData.Values["controller"]?.ToString() == controller &&
         ViewContext.RouteData.Values["action"]?.ToString() == action)
            ? "is-active" : string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Campus Library</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CampusLibrary.WebMvc.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container site-header__inner">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Campus Library home">
                <span class="brand__mark" aria-hidden="true">CL</span>
                <span class="brand__text"><strong>Campus Library</strong><small>Knowledge in common</small></span>
            </a>
            <div class="header-note">Main collection <span aria-hidden="true">·</span> Open daily</div>
        </div>
        <nav class="navbar navbar-expand-sm library-nav" aria-label="Primary navigation">
            <div class="container">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon">Menu</span>
                </button>
                <div class="navbar-collapse collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Home", "Index"))" asp-area="" asp-controller="Home" asp-action="Index">Overview</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Books", "Index"))" asp-area="" asp-controller="Books" asp-action="Index">Collection</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Members", "Index"))" asp-area="" asp-controller="Members" asp-action="Index">Members</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Loans", "Index"))" asp-area="" asp-controller="Loans" asp-action="Index">Open loans</a>
                        </li>
                    </ul>
                    <a class="nav-quick-link" asp-area="" asp-controller="Books" asp-action="Create">Add a title <span aria-hidden="true">↗</span></a>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="container page-shell">
            @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div><strong>Campus Library</strong><br /><span>Shared shelves for a curious campus.</span></div>
            <div class="footer-meta">Collection desk · Student Commons<br />© 2026 Campus Library</div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
