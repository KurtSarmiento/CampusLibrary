@model CampusLibrary.Data.Entities.Member

@{
    ViewData["Title"] = "Register a member";
}

<div class="page-heading"><div><p class="section-kicker mb-1">Our community</p><h1>Register a member</h1></div></div>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Sam Rivera" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" placeholder="e.g. sam.rivera@campus.edu" />
                <span asp-validation-for="Email" class="text-danger"></span>
                <span class="form-text text-muted">Must be unique — a member with this email already exists will be rejected.</span>
            </div>
            <div class="form-group">
                <input type="submit" value="Register member" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">← Back to members</a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
